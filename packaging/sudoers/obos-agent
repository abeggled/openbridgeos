Defaults:obos-agent secure_path="/usr/sbin:/usr/bin:/sbin:/bin"

Cmnd_Alias OBOS_AGENT_READONLY = \
  /usr/bin/obosctl status-summary, \
  /usr/bin/obosctl system-summary, \
  /usr/bin/obosctl update-summary, \
  /usr/bin/obosctl update-rollback-plan, \
  /usr/bin/obosctl backup-summary, \
  /usr/bin/obosctl backup-list, \
  /usr/bin/obosctl backup-prune-plan, \
  /usr/bin/obosctl logs-summary, \
  /usr/bin/obosctl logs-tail, \
  /usr/bin/obosctl portable-export-plan *, \
  /usr/bin/obosctl portable-import-plan *, \
  /usr/bin/obosctl restore-stage-summary, \
  /usr/bin/obosctl restore-stage-inspect *, \
  /usr/bin/obosctl restore-apply-plan *, \
  /usr/bin/obosctl mqtt-summary, \
  /usr/bin/obosctl tls-summary, \
  /usr/bin/obosctl security-summary, \
  /usr/bin/obosctl agent-audit-summary

Cmnd_Alias OBOS_AGENT_MUTATIONS = \
  /usr/bin/obosctl start, \
  /usr/bin/obosctl stop, \
  /usr/bin/obosctl restart, \
  /usr/bin/obosctl update, \
  /usr/bin/obosctl backup, \
  /usr/bin/obosctl backup-prune --confirm backup-prune, \
  /usr/bin/obosctl portable-export *, \
  /usr/bin/obosctl portable-import-stage *, \
  /usr/bin/obosctl restore-stage *, \
  /usr/bin/obosctl tls-generate, \
  /usr/bin/obosctl tls-export, \
  /usr/bin/obosctl mqtt-enable-lan, \
  /usr/bin/obosctl mqtt-enable-lan *, \
  /usr/bin/obosctl mqtt-disable-lan, \
  /usr/bin/obosctl set-hostname *, \
  /usr/bin/obosctl set-timezone *

obos-agent ALL=(root) NOPASSWD: OBOS_AGENT_READONLY, OBOS_AGENT_MUTATIONS
