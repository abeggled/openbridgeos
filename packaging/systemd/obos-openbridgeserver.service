[Unit]
Description=open bridge server managed by open bridge operating system
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service obos-first-boot.service

[Service]
Type=oneshot
WorkingDirectory=/srv/obos/apps/openbridgeserver
EnvironmentFile=/etc/obos/apps/openbridgeserver.env
ExecStart=/usr/bin/docker compose --env-file /etc/obos/apps/openbridgeserver.env up -d
ExecStop=/usr/bin/docker compose --env-file /etc/obos/apps/openbridgeserver.env down
RemainAfterExit=yes
TimeoutStartSec=0
Restart=on-failure
RestartSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
