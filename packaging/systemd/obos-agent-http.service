[Unit]
Description=open bridge operating system read-only agent HTTP bridge
After=network.target obos-first-boot.service

[Service]
Type=simple
User=obos-agent
Group=www-data
SupplementaryGroups=obos-agent
Environment=OBOS_AGENT_HTTP_SOCKET=/run/obos-agent-http/agent.sock
EnvironmentFile=-/etc/obos/update/agent-http-compat.env
RuntimeDirectory=obos-agent-http
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/lib/obos/obos-agent-http.py
Restart=on-failure
RestartSec=5s
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/obos /etc/nftables.conf /etc/hostname /etc/hosts -/etc/systemd/network -/etc/systemd/timesyncd.conf.d -/etc/default/keyboard /srv/obos/apps/openbridgeserver /srv/obos/backups /srv/obos/state
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
