[Unit]
Description=Renew the OBOS TLS leaf certificate when policy requires it
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/usr/lib/obos/auto-renew-leaf-certificate.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/obos/tls /srv/obos/state/trust

