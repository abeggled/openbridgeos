[Unit]
Description=open bridge operating system per-device recovery credentials
After=local-fs.target
Before=obos-first-boot.service
ConditionPathExists=!/etc/obos/system-credentials

[Service]
Type=oneshot
ExecStart=/usr/lib/obos/manage-system-credentials.sh ensure
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Account initialization must update passwd/shadow. Keep vendor binaries and
# boot content read-only while allowing the host-specific /etc hierarchy.
ProtectSystem=true
ReadWritePaths=/etc/obos
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
