OBOS_IMAGE_PROFILE=amd64-installer
OBOS_IMAGE_ARCH=amd64
OBOS_IMAGE_KIND=installer-iso
OBOS_DEBIAN_RELEASE=trixie
OBOS_DEBIAN_COMPONENTS=main,non-free-firmware
OBOS_BOOT_TARGET=bios,uefi
OBOS_OUTPUT_FORMAT=iso
OBOS_IMAGE_EXTENSION=iso
OBOS_BASE_PACKAGES=systemd-sysv,ca-certificates,curl,gnupg,openssh-client
OBOS_PROVISION_SCRIPT=scripts/bootstrap/provision-debian.sh
OBOS_FIRST_BOOT_SERVICE=obos-first-boot.service
OBOS_ISO_BUILDER=live-build
OBOS_ISO_BOOTLOADERS=grub-pc,grub-efi
OBOS_ISO_INSTALLER_MODE=live
OBOS_ISO_HYBRID=true
OBOS_ISO_REQUIRED_TOOLS=lb,xorriso,sha256sum
OBOS_IMAGE_DEFAULT_SSH=disabled
OBOS_NOTES="Hybrid BIOS/UEFI amd64 live installer ISO that installs the provisioned OBOS filesystem."
