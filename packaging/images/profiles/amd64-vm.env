OBOS_IMAGE_PROFILE=amd64-vm
OBOS_IMAGE_ARCH=amd64
OBOS_IMAGE_KIND=vm-image
OBOS_DEBIAN_RELEASE=trixie
OBOS_BOOT_TARGET=efi
OBOS_OUTPUT_FORMAT=qcow2
OBOS_BASE_PACKAGES=systemd-sysv,ca-certificates,curl,gnupg,openssh-client
OBOS_PROVISION_SCRIPT=scripts/bootstrap/provision-debian.sh
OBOS_FIRST_BOOT_SERVICE=obos-first-boot.service
OBOS_QCOW2_BASE_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20261001-2618/debian-13-genericcloud-amd64.qcow2
OBOS_QCOW2_BASE_IMAGE_SHA256=b2aca2bee42c7082fd6aba4a5bb1a89612087a405e99896920f3346f7b23b9d1
OBOS_QCOW2_MIN_SIZE=8G
OBOS_QCOW2_BUILDER=virt-customize
OBOS_QCOW2_REQUIRED_TOOLS=qemu-img,virt-customize,virt-sysprep,sha256sum
OBOS_IMAGE_DEFAULT_SSH=disabled
OBOS_NOTES="Development VM image profile for x86_64 hypervisors and bare-metal smoke tests."
