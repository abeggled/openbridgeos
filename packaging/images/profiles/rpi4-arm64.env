OBOS_IMAGE_PROFILE=rpi4-arm64
OBOS_IMAGE_ARCH=arm64
OBOS_IMAGE_KIND=rpi-image
OBOS_DEBIAN_RELEASE=trixie
OBOS_BOOT_TARGET=rpi4
OBOS_OUTPUT_FORMAT=raw
OBOS_BASE_PACKAGES=systemd-sysv,ca-certificates,curl,openssh-client
OBOS_PROVISION_SCRIPT=scripts/bootstrap/provision-debian.sh
OBOS_FIRST_BOOT_SERVICE=obos-first-boot.service
OBOS_RPI_NETWORK_INSTALLER_COMPATIBLE=true
OBOS_RPI_BOOT_MEDIA=sd,usb,nvme
OBOS_RPI_FIRMWARE_MODE=raspberry-pi-bootloader
OBOS_KERNEL_REQUIRED_CONFIG=CONFIG_BLK_DEV_NVME=y,CONFIG_PCIE_BRCMSTB=y,CONFIG_USB_XHCI_PCI=y
OBOS_NOTES="Raspberry Pi 4+ arm64 SD/USB/NVMe image profile for Raspberry Pi Network Installer compatible deployment."
