#!/usr/sbin/nft -f

flush ruleset

table inet obos_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # DHCP client renewals for appliances using dynamic network configuration.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

    # HTTPS reverse proxy. Open Bridge Server binds to localhost behind it.
    tcp dport 443 accept

    # Optional MQTT LAN access is managed by obosctl.
    # OBOS MQTT LAN BEGIN
    # MQTT LAN disabled by default.
    # OBOS MQTT LAN END
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
