/srv/obos/state/agent/obos-agent-audit.log {
  daily
  rotate 30
  missingok
  notifempty
  compress
  delaycompress
  create 0640 obos-agent obos-agent
}

/var/log/obos-update.log /var/log/obos-appliance-update.log {
  weekly
  rotate 4
  missingok
  notifempty
  compress
  delaycompress
  create 0600 root root
}
