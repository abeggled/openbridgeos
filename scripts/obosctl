#!/usr/bin/env sh
set -eu

APP_NAME="openbridgeserver"
APP_DIR="${OBOS_APP_DIR:-/srv/obos/apps/${APP_NAME}}"
ENV_FILE="${OBOS_ENV_FILE:-/etc/obos/apps/${APP_NAME}.env}"
BACKUP_DIR="${OBOS_BACKUP_DIR:-/srv/obos/backups}"
BACKUP_RETENTION_KEEP="${OBOS_BACKUP_RETENTION_KEEP:-10}"
STATE_DIR="${OBOS_STATE_DIR:-/srv/obos/state}"
AGENT_AUDIT_LOG="${OBOS_AGENT_AUDIT_LOG:-${STATE_DIR}/agent/obos-agent-audit.log}"
LAST_UPDATE_FILE="${OBOS_LAST_UPDATE_FILE:-${STATE_DIR}/last-update}"
RESTORE_STAGE_DIR="${OBOS_RESTORE_STAGE_DIR:-${STATE_DIR}/restore-staging}"
PORTABLE_EXPORT_DIR="${OBOS_PORTABLE_EXPORT_DIR:-${STATE_DIR}/portable-backups}"
PORTABLE_IMPORT_DIR="${OBOS_PORTABLE_IMPORT_DIR:-${STATE_DIR}/portable-imports}"
ONBOARDING_STATE_DIR="${OBOS_ONBOARDING_STATE_DIR:-${STATE_DIR}/onboarding}"
TLS_DIR="${OBOS_TLS_DIR:-/etc/obos/tls}"
APPLIANCE_ID_FILE="${OBOS_APPLIANCE_ID_FILE:-/etc/obos/appliance-id}"
SERVICE_NAME="obos-openbridgeserver.service"
HEALTH_URL="${OBOS_HEALTH_URL:-http://127.0.0.1:8080/api/v1/system/health}"
PROXY_HEALTH_HOST="${OBOS_PROXY_HEALTH_HOST:-obos.local}"
PROXY_HEALTH_URL="${OBOS_PROXY_HEALTH_URL:-https://${PROXY_HEALTH_HOST}/api/v1/system/health}"
TLS_CA_CERT="${OBOS_TLS_CA_CERT:-${TLS_DIR}/obos-local-ca.crt}"
TLS_GENERATE_SCRIPT="${OBOS_TLS_GENERATE_SCRIPT:-/usr/lib/obos/generate-tls-material.sh}"
TLS_LEAF_RENEWAL_PLAN_SCRIPT="${OBOS_TLS_LEAF_RENEWAL_PLAN_SCRIPT:-/usr/lib/obos/plan-leaf-renewal.sh}"
TLS_LEAF_RENEWAL_SCRIPT="${OBOS_TLS_LEAF_RENEWAL_SCRIPT:-/usr/lib/obos/renew-leaf-certificate.sh}"
TLS_INFO_SCRIPT="${OBOS_TLS_INFO_SCRIPT:-/usr/lib/obos/print-trust-info.sh}"
TLS_EXPORT_SCRIPT="${OBOS_TLS_EXPORT_SCRIPT:-/usr/lib/obos/export-trust-bundle.sh}"
BOOT_TRUST_SCRIPT="${OBOS_BOOT_TRUST_SCRIPT:-/usr/lib/obos/export-boot-trust-summary.sh}"
TLS_STATUS_SCRIPT="${OBOS_TLS_STATUS_SCRIPT:-/usr/lib/obos/check-tls-status.sh}"
MQTT_LAN_SCRIPT="${OBOS_MQTT_LAN_SCRIPT:-/usr/lib/obos/set-mqtt-lan-access.sh}"
SECURITY_BASELINE_SCRIPT="${OBOS_SECURITY_BASELINE_SCRIPT:-/usr/lib/obos/security-baseline.sh}"
MVP_READINESS_SCRIPT="${OBOS_MVP_READINESS_SCRIPT:-/usr/lib/obos/mvp-runtime-readiness.sh}"
WEB_AUTH_SCRIPT="${OBOS_WEB_AUTH_SCRIPT:-/usr/lib/obos/generate-web-auth.sh}"

usage() {
  cat <<'EOF'
Usage: obosctl <command>

Commands:
  status            Show systemd, container, and health status
  status-summary    Print machine-readable appliance status
  system-summary    Print machine-readable host and network basics
  set-hostname      Set appliance hostname after validation
  set-timezone      Set appliance timezone after validation
  security-summary  Print machine-readable security baseline status
  mvp-readiness-summary
                    Print machine-readable technical MVP runtime readiness
  web-auth-set     Set the initial web console Basic Auth password from a file
  web-auth-rotate  Rotate generated web console Basic Auth credentials
  agent-audit-summary
                    Print machine-readable agent mutation audit status
  start             Start open bridge server
  stop              Stop open bridge server
  restart           Restart open bridge server
  update            Pull container images, restart, and verify health
  update-summary    Print machine-readable last update status
  update-rollback-plan
                    Print the non-destructive rollback plan for the last update
  update-rollback-stage
                    Stage the last update backup for confirmed CLI rollback
  logs              Follow open bridge server stack logs
  logs-summary      Print metadata-only log availability status
  logs-tail         Print bounded recent service and container logs
  backup            Create a timestamped appliance backup
  backup-summary    Print machine-readable latest backup status
  backup-list       Print machine-readable appliance backup inventory
  backup-prune-plan Print a non-destructive backup retention plan
  backup-prune      Delete old backups after explicit confirmation
  portable-export-plan
                    Print the non-destructive encrypted backup export plan
  portable-export  Create an encrypted portable backup export
  portable-import-plan
                    Print the non-destructive encrypted backup import plan
  portable-import-stage
                    Decrypt a portable backup into private import staging
  restore-inspect   Inspect an appliance backup before restore
  restore-plan      Print the non-destructive restore plan for a backup
  restore-stage     Extract a backup into private restore staging
  restore-stage-inspect
                    Inspect a private restore staging directory
  restore-stage-summary
                    Print machine-readable restore staging inventory
  restore-apply-plan
                    Print the non-destructive apply plan for a staged restore
  restore-apply    Apply a staged restore after explicit confirmation
  health            Check open bridge server localhost health endpoint
  proxy-health      Check HTTPS reverse proxy health with local CA trust
  tls-generate      Generate local CA and leaf certificate material
  tls-renew-leaf-plan
                    Print non-destructive TLS leaf renewal plan
  tls-renew-leaf   Renew the nginx leaf certificate after explicit confirmation
  tls-status        Check local CA and leaf certificate status
  tls-summary       Print machine-readable TLS trust status
  tls-info          Print TLS trust fingerprints and paths
  tls-export        Export public TLS trust bundle
  tls-export-boot   Export public TLS trust summary to a boot partition
  mqtt-status       Show MQTT bind addresses
  mqtt-summary      Print machine-readable MQTT exposure status
  mqtt-enable-lan   Enable explicit LAN MQTT access, optionally limited to CIDR
  mqtt-disable-lan  Disable LAN MQTT access and bind MQTT to localhost
EOF
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "obosctl $1 must run as root" >&2
    exit 1
  fi
}

require_files() {
  [ -d "${APP_DIR}" ] || {
    echo "missing app directory: ${APP_DIR}" >&2
    exit 1
  }
  [ -f "${ENV_FILE}" ] || {
    echo "missing environment file: ${ENV_FILE}" >&2
    exit 1
  }
}

run_helper() {
  helper="$1"
  shift
  [ -x "${helper}" ] || {
    echo "missing executable helper: ${helper}" >&2
    exit 1
  }
  "${helper}" "$@"
}

validate_onboarding_password_file() {
  password_file="$1"
  case "${password_file}" in
    "${ONBOARDING_STATE_DIR}"/obos-web-password-*) ;;
    *) echo "web-auth-set password file must be below ${ONBOARDING_STATE_DIR}" >&2; exit 2 ;;
  esac
  [ -f "${password_file}" ] || {
    echo "web-auth-set password file missing: ${password_file}" >&2
    exit 2
  }
}

key_value() {
  key="$1"
  file="$2"
  awk -F= -v key="${key}" '
    $1 == key {
      print substr($0, length(key) + 2)
      found = 1
      exit
    }
    END {
      if (!found) {
        exit 1
      }
    }
  ' "${file}" || true
}

compose() {
  require_files
  docker compose --env-file "${ENV_FILE}" --project-directory "${APP_DIR}" -f "${APP_DIR}/compose.yaml" "$@"
}

logs_summary() {
  echo "format=obos-logs-summary-v1"
  echo "service=${SERVICE_NAME}"
  echo "app_dir=${APP_DIR}"
  echo "raw_logs_exposed=false"
  echo "bounded_logs_exposed=true"
  echo "bounded_log_line_limit=100"

  if command -v journalctl >/dev/null 2>&1; then
    echo "journalctl_present=true"
    journal_count="$(journalctl --quiet -u "${SERVICE_NAME}" --since '-1 hour' --no-pager 2>/dev/null | wc -l | awk '{print $1}')"
    echo "journal_entry_count_last_hour=${journal_count:-unknown}"
  else
    echo "journalctl_present=false"
    echo "journal_entry_count_last_hour=unknown"
  fi

  if command -v docker >/dev/null 2>&1; then
    echo "docker_present=true"
  else
    echo "docker_present=false"
  fi
}

logs_tail() {
  line_limit=100
  echo "format=obos-logs-tail-v1"
  echo "service=${SERVICE_NAME}"
  echo "app_dir=${APP_DIR}"
  echo "line_limit=${line_limit}"
  echo "mode=bounded-tail"
  echo "section=journal"

  if command -v journalctl >/dev/null 2>&1; then
    journalctl --quiet -u "${SERVICE_NAME}" -n "${line_limit}" --no-pager -o short-iso 2>/dev/null |
      sed 's/^/log=journal|/'
  else
    echo "log=journal|unavailable: journalctl missing"
  fi

  echo "section=compose"
  if [ -d "${APP_DIR}" ] && [ -f "${ENV_FILE}" ] && command -v docker >/dev/null 2>&1; then
    compose logs --no-color --tail="${line_limit}" 2>/dev/null |
      sed 's/^/log=compose|/'
  else
    echo "log=compose|unavailable: app files or docker missing"
  fi
}

health() {
  if command -v curl >/dev/null 2>&1; then
    curl --fail --silent --show-error --max-time 5 "${HEALTH_URL}" >/dev/null
  else
    wget -q -T 5 -O /dev/null "${HEALTH_URL}"
  fi
}

system_summary() {
  hostname_value="$(hostname 2>/dev/null || true)"
  timezone_value=
  primary_interface=

  if command -v timedatectl >/dev/null 2>&1; then
    timezone_value="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
  fi
  if [ -z "${timezone_value}" ] && [ -r /etc/timezone ]; then
    timezone_value="$(sed -n '1p' /etc/timezone 2>/dev/null || true)"
  fi

  if command -v ip >/dev/null 2>&1; then
    primary_interface="$(ip route show default 2>/dev/null | awk '
      NR == 1 {
        for (i = 1; i <= NF; i++) {
          if ($i == "dev") {
            print $(i + 1)
            exit
          }
        }
      }
    ')"
  fi

  echo "format=obos-system-summary-v1"
  echo "hostname=${hostname_value:-unknown}"
  echo "timezone=${timezone_value:-unknown}"
  if [ -n "${primary_interface}" ]; then
    echo "default_route_present=true"
    echo "primary_interface=${primary_interface}"
  else
    echo "default_route_present=false"
    echo "primary_interface=unknown"
  fi
}

validate_hostname() {
  hostname_value="$1"
  case "${hostname_value}" in
    ""|.*|*-|*_)
      echo "hostname is invalid" >&2
      return 2
      ;;
  esac
  if [ "${#hostname_value}" -gt 63 ]; then
    echo "hostname is too long" >&2
    return 2
  fi
  printf '%s\n' "${hostname_value}" |
    grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$' || {
      echo "hostname contains unsupported characters" >&2
      return 2
    }
}

set_hostname() {
  require_root set-hostname
  hostname_value="${1:-}"
  validate_hostname "${hostname_value}"
  if command -v hostnamectl >/dev/null 2>&1; then
    hostnamectl set-hostname "${hostname_value}"
  else
    printf '%s\n' "${hostname_value}" > /etc/hostname
    hostname "${hostname_value}" 2>/dev/null || true
  fi
  echo "format=obos-set-hostname-v1"
  echo "hostname=${hostname_value}"
  echo "set_hostname=ok"
}

validate_timezone() {
  timezone_value="$1"
  case "${timezone_value}" in
    ""|/*|*"/../"*|*".."*|*\\*|*": "*|*" "*)
      echo "timezone is invalid" >&2
      return 2
      ;;
  esac
  printf '%s\n' "${timezone_value}" |
    grep -Eq '^(UTC|[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)+)$' || {
      echo "timezone contains unsupported characters" >&2
      return 2
    }
  if [ -d /usr/share/zoneinfo ] && [ ! -f "/usr/share/zoneinfo/${timezone_value}" ]; then
    echo "timezone is not installed: ${timezone_value}" >&2
    return 2
  fi
}

set_timezone() {
  require_root set-timezone
  timezone_value="${1:-}"
  validate_timezone "${timezone_value}"
  if command -v timedatectl >/dev/null 2>&1; then
    timedatectl set-timezone "${timezone_value}"
  else
    ln -snf "/usr/share/zoneinfo/${timezone_value}" /etc/localtime
    printf '%s\n' "${timezone_value}" > /etc/timezone
  fi
  echo "format=obos-set-timezone-v1"
  echo "timezone=${timezone_value}"
  echo "set_timezone=ok"
}

proxy_health() {
  [ -f "${TLS_CA_CERT}" ] || {
    echo "missing local CA certificate: ${TLS_CA_CERT}" >&2
    return 1
  }
  command -v curl >/dev/null 2>&1 || {
    echo "curl is required for verified HTTPS proxy health checks" >&2
    return 1
  }

  curl --fail --silent --show-error --max-time 5 \
    --cacert "${TLS_CA_CERT}" \
    --resolve "${PROXY_HEALTH_HOST}:443:127.0.0.1" \
    "${PROXY_HEALTH_URL}" >/dev/null
}

status() {
  systemctl --no-pager --lines=0 status "${SERVICE_NAME}" || true
  echo
  compose ps || true
  echo
  failed=0
  if health; then
    echo "health-local: ok"
  else
    echo "health-local: failed"
    failed=1
  fi
  if proxy_health; then
    echo "health-https-proxy: ok"
  else
    echo "health-https-proxy: failed"
    failed=1
  fi
  if [ -f "${LAST_UPDATE_FILE}" ]; then
    echo
    echo "last-update:"
    sed 's/^/  /' "${LAST_UPDATE_FILE}"
  fi
  return "${failed}"
}

status_summary() {
  failed=0
  service_active="unknown"
  if command -v systemctl >/dev/null 2>&1; then
    service_active="$(systemctl is-active "${SERVICE_NAME}" 2>/dev/null || true)"
    [ -n "${service_active}" ] || service_active="unknown"
  fi

  health_local="failed"
  if health; then
    health_local="ok"
  else
    failed=1
  fi

  health_https_proxy="failed"
  if proxy_health; then
    health_https_proxy="ok"
  else
    failed=1
  fi

  last_update_present=false
  if [ -f "${LAST_UPDATE_FILE}" ]; then
    last_update_present=true
  fi

  cat <<EOF
format=obos-status-summary-v1
app=${APP_NAME}
service=${SERVICE_NAME}
service_active=${service_active}
health_local=${health_local}
health_https_proxy=${health_https_proxy}
last_update_present=${last_update_present}
EOF

  return "${failed}"
}

write_backup_manifest() {
  manifest_file="$1"
  stamp="$2"
  tls_included="$3"

  appliance_id="unknown"
  if [ -f "${APPLIANCE_ID_FILE}" ]; then
    appliance_id="$(sed -n '1p' "${APPLIANCE_ID_FILE}")"
  fi

  hostname_value="unknown"
  if command -v hostname >/dev/null 2>&1; then
    hostname_value="$(hostname)"
  fi

  cat > "${manifest_file}" <<EOF
format=obos-backup-v1
created_at=${stamp}
app=${APP_NAME}
hostname=${hostname_value}
appliance_id=${appliance_id}
includes_app_env=true
includes_app_data=true
includes_mqtt_data=true
includes_logs=false
includes_appliance_id=true
includes_tls_material=${tls_included}
contains_secrets=true
EOF
}

backup() {
  require_root backup
  require_files
  install -d -m 0750 "${BACKUP_DIR}"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  target="${BACKUP_DIR}/obos-${APP_NAME}-${stamp}.tar.gz"
  env_dir="$(dirname -- "${ENV_FILE}")"
  env_name="$(basename -- "${ENV_FILE}")"
  tls_parent="$(dirname -- "${TLS_DIR}")"
  tls_name="$(basename -- "${TLS_DIR}")"
  appliance_id_dir="$(dirname -- "${APPLIANCE_ID_FILE}")"
  appliance_id_name="$(basename -- "${APPLIANCE_ID_FILE}")"
  manifest_dir="$(mktemp -d)"
  manifest_name="obos-backup-manifest.txt"
  manifest_file="${manifest_dir}/${manifest_name}"

  if [ -d "${TLS_DIR}" ]; then
    write_backup_manifest "${manifest_file}" "${stamp}" true
    tar -czf "${target}" \
      --exclude=mqtt/log \
      -C "${manifest_dir}" "${manifest_name}" \
      -C "${env_dir}" "${env_name}" \
      -C "${appliance_id_dir}" "${appliance_id_name}" \
      -C "${tls_parent}" "${tls_name}" \
      -C "${APP_DIR}" data mqtt obos-app.yaml compose.yaml mosquitto.conf
    echo "backup includes TLS private key material for appliance identity restore" >&2
  else
    write_backup_manifest "${manifest_file}" "${stamp}" false
    tar -czf "${target}" \
      --exclude=mqtt/log \
      -C "${manifest_dir}" "${manifest_name}" \
      -C "${env_dir}" "${env_name}" \
      -C "${appliance_id_dir}" "${appliance_id_name}" \
      -C "${APP_DIR}" data mqtt obos-app.yaml compose.yaml mosquitto.conf
    echo "backup warning: TLS material was not found and was not included" >&2
  fi

  rm -rf "${manifest_dir}"
  chmod 0600 "${target}"
  echo "backup: ${target}"
}

backup_list() {
  count=0
  echo "format=obos-backup-list-v1"
  echo "backup_dir=${BACKUP_DIR}"

  for backup_file in "${BACKUP_DIR}"/obos-"${APP_NAME}"-*.tar.gz; do
    [ -f "${backup_file}" ] || continue
    count=$((count + 1))
    size_bytes="unknown"
    mode="unknown"
    if command -v stat >/dev/null 2>&1; then
      size_bytes="$(stat -c '%s' "${backup_file}" 2>/dev/null || echo unknown)"
      mode="$(stat -c '%a' "${backup_file}" 2>/dev/null || echo unknown)"
    fi
    echo "backup=${backup_file}|size_bytes=${size_bytes}|mode=${mode}"
  done

  echo "backup_count=${count}"
}

backup_summary() {
  count=0
  latest_backup=
  latest_mtime=0
  echo "format=obos-backup-summary-v1"
  echo "backup_dir=${BACKUP_DIR}"

  for backup_file in "${BACKUP_DIR}"/obos-"${APP_NAME}"-*.tar.gz; do
    [ -f "${backup_file}" ] || continue
    count=$((count + 1))
    if command -v stat >/dev/null 2>&1; then
      mtime="$(stat -c '%Y' "${backup_file}" 2>/dev/null || echo 0)"
    else
      mtime=0
    fi
    if [ "${mtime}" -ge "${latest_mtime}" ]; then
      latest_mtime="${mtime}"
      latest_backup="${backup_file}"
    fi
  done

  echo "backup_count=${count}"
  if [ -z "${latest_backup}" ]; then
    echo "latest_backup_present=false"
    return 0
  fi

  size_bytes=unknown
  mode=unknown
  if command -v stat >/dev/null 2>&1; then
    size_bytes="$(stat -c '%s' "${latest_backup}" 2>/dev/null || echo unknown)"
    mode="$(stat -c '%a' "${latest_backup}" 2>/dev/null || echo unknown)"
  fi
  echo "latest_backup_present=true"
  echo "latest_backup=${latest_backup}"
  echo "latest_backup_mtime=${latest_mtime}"
  echo "latest_backup_size_bytes=${size_bytes}"
  echo "latest_backup_mode=${mode}"

  if restore_inspect "${latest_backup}" >/dev/null; then
    echo "latest_backup_inspection=pass"
  else
    echo "latest_backup_inspection=fail"
    return 0
  fi

  if tar -xOzf "${latest_backup}" obos-backup-manifest.txt >/dev/null 2>&1; then
    contains_secrets="$(tar -xOzf "${latest_backup}" obos-backup-manifest.txt | sed -n 's/^contains_secrets=//p' | head -n 1)"
    includes_logs="$(tar -xOzf "${latest_backup}" obos-backup-manifest.txt | sed -n 's/^includes_logs=//p' | head -n 1)"
    tls_private_keys="$(tar -xOzf "${latest_backup}" obos-backup-manifest.txt | sed -n 's/^tls_private_keys=//p' | head -n 1)"
  else
    contains_secrets=unknown
    includes_logs=unknown
    tls_private_keys=unknown
  fi
  echo "latest_backup_contains_secrets=${contains_secrets:-unknown}"
  echo "latest_backup_includes_logs=${includes_logs:-unknown}"
  echo "latest_backup_tls_private_keys=${tls_private_keys:-unknown}"
}

backup_prune_plan() {
  keep_count="${1:-${BACKUP_RETENTION_KEEP}}"
  case "${keep_count}" in
    ''|*[!0-9]*) echo "backup prune plan: keep count must be a positive integer" >&2; return 2 ;;
    0) echo "backup prune plan: keep count must be greater than zero" >&2; return 2 ;;
  esac

  list_file="$(mktemp)"
  sorted_file="$(mktemp)"
  trap 'rm -f "${list_file}" "${sorted_file}"' EXIT INT TERM

  for backup_file in "${BACKUP_DIR}"/obos-"${APP_NAME}"-*.tar.gz; do
    [ -f "${backup_file}" ] || continue
    if command -v stat >/dev/null 2>&1; then
      mtime="$(stat -c '%Y' "${backup_file}" 2>/dev/null || echo 0)"
      size_bytes="$(stat -c '%s' "${backup_file}" 2>/dev/null || echo unknown)"
    else
      mtime=0
      size_bytes=unknown
    fi
    printf '%s\t%s\t%s\n' "${mtime}" "${size_bytes}" "${backup_file}" >> "${list_file}"
  done

  sort -r -n "${list_file}" > "${sorted_file}" 2>/dev/null || true

  total_count=0
  keep_seen=0
  delete_count=0
  echo "format=obos-backup-prune-plan-v1"
  echo "mode=non-destructive"
  echo "backup_dir=${BACKUP_DIR}"
  echo "keep_count=${keep_count}"

  while IFS="$(printf '\t')" read -r mtime size_bytes backup_file; do
    [ -n "${backup_file}" ] || continue
    total_count=$((total_count + 1))
    if [ "${keep_seen}" -lt "${keep_count}" ]; then
      keep_seen=$((keep_seen + 1))
      echo "keep=${backup_file}|mtime=${mtime}|size_bytes=${size_bytes}"
    else
      delete_count=$((delete_count + 1))
      echo "delete_candidate=${backup_file}|mtime=${mtime}|size_bytes=${size_bytes}"
    fi
  done < "${sorted_file}"

  echo "backup_count=${total_count}"
  echo "delete_candidate_count=${delete_count}"
  rm -f "${list_file}" "${sorted_file}"
  trap - EXIT INT TERM
}

backup_prune() {
  confirmed=false
  if [ "${1:-}" = "--confirm" ] && [ "${2:-}" = "backup-prune" ]; then
    confirmed=true
  elif [ -n "${1:-}" ]; then
    echo "usage: obosctl backup-prune [--confirm backup-prune]" >&2
    return 2
  fi

  plan_file="$(mktemp)"
  trap 'rm -f "${plan_file}"' EXIT INT TERM
  backup_prune_plan > "${plan_file}"

  echo "format=obos-backup-prune-v1"
  if [ "${confirmed}" = true ]; then
    echo "mode=confirmed"
  else
    echo "mode=dry-run"
  fi
  sed -n '/^backup_dir=/p; /^keep_count=/p; /^backup_count=/p; /^delete_candidate_count=/p' "${plan_file}"

  delete_seen=0
  prune_exit=0
  while IFS= read -r plan_line; do
    case "${plan_line}" in
      delete_candidate=*)
        candidate="${plan_line#delete_candidate=}"
        backup_file="${candidate%%|mtime=*}"
        delete_seen=$((delete_seen + 1))
        if [ "${confirmed}" = true ]; then
          if rm -f -- "${backup_file}"; then
            echo "deleted=${backup_file}"
          else
            echo "delete_failed=${backup_file}"
            prune_exit=1
            break
          fi
        else
          echo "would_delete=${backup_file}"
        fi
        ;;
    esac
  done < "${plan_file}"

  echo "processed_delete_candidate_count=${delete_seen}"
  rm -f "${plan_file}"
  trap - EXIT INT TERM
  return "${prune_exit}"
}

portable_export_plan() {
  backup_path="${1:-}"
  [ -n "${backup_path}" ] || {
    echo "portable export plan: backup path is required" >&2
    return 2
  }
  if ! restore_inspect "${backup_path}" >/dev/null; then
    echo "portable export plan: backup inspection failed" >&2
    return 1
  fi

  echo "format=obos-portable-backup-export-plan-v1"
  echo "mode=non-destructive"
  echo "portable_format=obos-portable-backup-v1"
  echo "source_backup=${backup_path}"
  echo "export_dir=${PORTABLE_EXPORT_DIR}"
  echo "raw_backup_download_allowed=false"
  echo "authenticated_encryption_required=true"
  echo "passphrase_required=true"
  echo "metadata_only_cleartext=true"
  echo "payload_contains_secrets=true"
  echo "download_after_encryption=true"
  echo "import_plan_command=sudo obosctl portable-import-plan <portable-backup>"
  echo "portable export plan: PASS"
}

sha256_file() {
  file="$1"
  sha256sum "${file}" | awk '{print $1}'
}

portable_export() {
  require_root portable-export
  backup_path="${1:-}"
  passphrase_file="${2:-}"
  [ -n "${backup_path}" ] || {
    echo "portable export: backup path is required" >&2
    return 2
  }
  [ -n "${passphrase_file}" ] || {
    echo "portable export: passphrase file is required" >&2
    return 2
  }
  [ -s "${passphrase_file}" ] || {
    echo "portable export: passphrase file is missing or empty" >&2
    return 2
  }
  command -v gpg >/dev/null 2>&1 || {
    echo "portable export: gpg is required" >&2
    return 1
  }
  command -v sha256sum >/dev/null 2>&1 || {
    echo "portable export: sha256sum is required" >&2
    return 1
  }
  if ! restore_inspect "${backup_path}" >/dev/null; then
    echo "portable export: backup inspection failed" >&2
    return 1
  fi

  install -d -m 0750 "${PORTABLE_EXPORT_DIR}"
  if getent group obos-agent >/dev/null 2>&1; then
    chgrp obos-agent "${PORTABLE_EXPORT_DIR}"
    chmod 0750 "${PORTABLE_EXPORT_DIR}"
  fi
  work_dir="$(mktemp -d "${PORTABLE_EXPORT_DIR}/export.XXXXXXXX")"
  chmod 0700 "${work_dir}"
  trap 'rm -rf "${work_dir}"' EXIT INT TERM
  created_at="$(date -u +%Y%m%dT%H%M%SZ)"
  metadata_file="${work_dir}/metadata.txt"
  payload_file="${work_dir}/payload.tar.gz.gpg"
  target="${PORTABLE_EXPORT_DIR}/obos-portable-${created_at}.tar"

  gpg --batch --yes --pinentry-mode loopback \
    --passphrase-file "${passphrase_file}" \
    --symmetric --cipher-algo AES256 --force-mdc --s2k-mode 3 --s2k-digest-algo SHA512 \
    --output "${payload_file}" "${backup_path}"
  chmod 0600 "${payload_file}"

  appliance_id_hash="unknown"
  if [ -f "${APPLIANCE_ID_FILE}" ] && [ -r "${APPLIANCE_ID_FILE}" ]; then
    appliance_id_hash="$(sha256_file "${APPLIANCE_ID_FILE}")"
  fi
  backup_manifest_hash="$(tar -xOzf "${backup_path}" obos-backup-manifest.txt | sha256sum | awk '{print $1}')"
  payload_hash="$(sha256_file "${payload_file}")"
  backup_hash="$(sha256_file "${backup_path}")"

  cat > "${metadata_file}" <<EOF
format=obos-portable-backup-v1
created_at=${created_at}
source_backup=${backup_path}
source_backup_sha256=${backup_hash}
source_appliance_id_sha256=${appliance_id_hash}
backup_manifest_sha256=${backup_manifest_hash}
encryption_method=gpg-symmetric-aes256-s2k-sha512
integrity_protection=gpg-mdc
payload_file=payload.tar.gz.gpg
payload_sha256=${payload_hash}
payload_contains_secrets=true
metadata_only_cleartext=true
raw_backup_download_allowed=false
EOF
  chmod 0600 "${metadata_file}"

  tar -cf "${target}" -C "${work_dir}" metadata.txt payload.tar.gz.gpg
  chmod 0600 "${target}"
  if getent group obos-agent >/dev/null 2>&1; then
    chgrp obos-agent "${target}"
    chmod 0640 "${target}"
  fi
  rm -rf "${work_dir}"
  trap - EXIT INT TERM

  echo "format=obos-portable-backup-export-v1"
  echo "portable_format=obos-portable-backup-v1"
  echo "portable_backup=${target}"
  echo "portable_metadata=metadata.txt"
  echo "payload_sha256=${payload_hash}"
  echo "encryption_method=gpg-symmetric-aes256-s2k-sha512"
  echo "integrity_protection=gpg-mdc"
  echo "portable export: PASS"
}

portable_import_plan() {
  portable_path="${1:-}"
  [ -n "${portable_path}" ] || {
    echo "portable import plan: portable backup path is required" >&2
    return 2
  }
  case "${portable_path}" in
    "${PORTABLE_IMPORT_DIR}"/*) ;;
    *) echo "portable import plan: path must be below ${PORTABLE_IMPORT_DIR}" >&2; return 2 ;;
  esac
  case "${portable_path}" in
    *'/../'*|*'/..'|'../'*|..)
      echo "portable import plan: path must not contain parent traversal" >&2
      return 2
      ;;
  esac

  echo "format=obos-portable-backup-import-plan-v1"
  echo "mode=non-destructive"
  echo "portable_format=obos-portable-backup-v1"
  echo "portable_backup=${portable_path}"
  echo "import_dir=${PORTABLE_IMPORT_DIR}"
  echo "decrypt_to_private_staging=true"
  echo "verify_payload_hash=true"
  echo "run_backup_inspection=true"
  echo "restore_stage_required=true"
  echo "live_apply_allowed=false"
  echo "pre_restore_backup_required=true"
  echo "portable import plan: PASS"
}

portable_import_stage() {
  require_root portable-import-stage
  portable_path="${1:-}"
  passphrase_file="${2:-}"
  [ -n "${portable_path}" ] || {
    echo "portable import stage: portable backup path is required" >&2
    return 2
  }
  [ -n "${passphrase_file}" ] || {
    echo "portable import stage: passphrase file is required" >&2
    return 2
  }
  case "${portable_path}" in
    "${PORTABLE_IMPORT_DIR}"/*) ;;
    *) echo "portable import stage: path must be below ${PORTABLE_IMPORT_DIR}" >&2; return 2 ;;
  esac
  case "${portable_path}" in
    *'/../'*|*'/..'|'../'*|..)
      echo "portable import stage: path must not contain parent traversal" >&2
      return 2
      ;;
  esac
  [ -f "${portable_path}" ] || {
    echo "portable import stage: portable backup not found" >&2
    return 1
  }
  [ -s "${passphrase_file}" ] || {
    echo "portable import stage: passphrase file is missing or empty" >&2
    return 2
  }
  command -v gpg >/dev/null 2>&1 || {
    echo "portable import stage: gpg is required" >&2
    return 1
  }
  command -v sha256sum >/dev/null 2>&1 || {
    echo "portable import stage: sha256sum is required" >&2
    return 1
  }

  install -d -m 0700 "${PORTABLE_IMPORT_DIR}"
  stage_dir="$(mktemp -d "${PORTABLE_IMPORT_DIR}/import.XXXXXXXX")"
  extract_dir="${stage_dir}/portable"
  install -d -m 0700 "${extract_dir}"
  trap 'rm -rf "${stage_dir}"' EXIT INT TERM

  list_file="${stage_dir}/portable.list"
  if ! tar -tf "${portable_path}" > "${list_file}"; then
    echo "portable import stage: portable backup is not readable as tar" >&2
    return 1
  fi
  if grep -Eq '(^/|(^|/)\.\.(/|$))' "${list_file}"; then
    echo "portable import stage: portable backup contains unsafe paths" >&2
    return 1
  fi
  grep -qx 'metadata.txt' "${list_file}" || {
    echo "portable import stage: metadata missing" >&2
    return 1
  }
  grep -qx 'payload.tar.gz.gpg' "${list_file}" || {
    echo "portable import stage: encrypted payload missing" >&2
    return 1
  }

  tar -xf "${portable_path}" -C "${extract_dir}" metadata.txt payload.tar.gz.gpg
  metadata_file="${extract_dir}/metadata.txt"
  payload_file="${extract_dir}/payload.tar.gz.gpg"
  grep -qx 'format=obos-portable-backup-v1' "${metadata_file}" || {
    echo "portable import stage: unsupported portable format" >&2
    return 1
  }
  expected_payload_hash="$(key_value payload_sha256 "${metadata_file}")"
  actual_payload_hash="$(sha256_file "${payload_file}")"
  if [ -z "${expected_payload_hash}" ] || [ "${expected_payload_hash}" != "${actual_payload_hash}" ]; then
    echo "portable import stage: payload hash mismatch" >&2
    return 1
  fi

  decrypted_backup="${stage_dir}/backup.tar.gz"
  if ! gpg --batch --yes --pinentry-mode loopback \
    --passphrase-file "${passphrase_file}" \
    --output "${decrypted_backup}" --decrypt "${payload_file}"; then
    echo "portable import stage: payload decryption failed" >&2
    return 1
  fi
  chmod 0600 "${decrypted_backup}"

  expected_backup_hash="$(key_value source_backup_sha256 "${metadata_file}")"
  actual_backup_hash="$(sha256_file "${decrypted_backup}")"
  if [ -z "${expected_backup_hash}" ] || [ "${expected_backup_hash}" != "${actual_backup_hash}" ]; then
    echo "portable import stage: decrypted backup hash mismatch" >&2
    return 1
  fi
  if ! restore_inspect "${decrypted_backup}" >/dev/null; then
    echo "portable import stage: decrypted backup inspection failed" >&2
    return 1
  fi

  staged_at="$(date -u +%Y%m%dT%H%M%SZ)"
  manifest_file="${stage_dir}/obos-portable-import-stage.txt"
  cat > "${manifest_file}" <<EOF
format=obos-portable-import-stage-v1
staged_at=${staged_at}
portable_backup=${portable_path}
stage_dir=${stage_dir}
decrypted_backup=${decrypted_backup}
portable_format=obos-portable-backup-v1
payload_sha256=${actual_payload_hash}
decrypted_backup_sha256=${actual_backup_hash}
restore_inspection=pass
mode=private-import-staging
live_apply_allowed=false
EOF
  chmod 0600 "${manifest_file}"
  trap - EXIT INT TERM

  echo "format=obos-portable-import-stage-v1"
  echo "portable_backup=${portable_path}"
  echo "stage_dir=${stage_dir}"
  echo "decrypted_backup=${decrypted_backup}"
  echo "restore_inspection=pass"
  echo "live_apply_allowed=false"
  echo "next=sudo obosctl restore-stage ${decrypted_backup}"
  echo "portable import stage: PASS"
}

agent_audit_summary() {
  limit="${1:-20}"
  case "${limit}" in
    ''|*[!0-9]*) echo "agent audit summary: limit must be a positive integer" >&2; return 2 ;;
    0) echo "agent audit summary: limit must be greater than zero" >&2; return 2 ;;
  esac
  if [ "${limit}" -gt 100 ]; then
    echo "agent audit summary: limit must be 100 or less" >&2
    return 2
  fi

  echo "format=obos-agent-audit-summary-v1"
  echo "audit_log=${AGENT_AUDIT_LOG}"
  echo "recent_limit=${limit}"

  if [ ! -f "${AGENT_AUDIT_LOG}" ]; then
    echo "log_present=false"
    echo "entry_count=0"
    return 0
  fi

  echo "log_present=true"
  entry_count="$(grep -Fc 'format=obos-agent-audit-v1|' "${AGENT_AUDIT_LOG}" 2>/dev/null || true)"
  echo "entry_count=${entry_count:-0}"

  tail -n "${limit}" "${AGENT_AUDIT_LOG}" |
    while IFS= read -r audit_line; do
      case "${audit_line}" in
        format=obos-agent-audit-v1\|*)
          echo "event=${audit_line#format=obos-agent-audit-v1|}"
          ;;
      esac
    done
}

restore_inspect() {
  archive="${1:-}"
  [ -n "${archive}" ] || {
    echo "usage: obosctl restore-inspect <backup.tar.gz>" >&2
    return 2
  }
  [ -f "${archive}" ] || {
    echo "backup archive not found: ${archive}" >&2
    return 1
  }

  list_file="$(mktemp)"
  if ! tar -tzf "${archive}" > "${list_file}"; then
    rm -f "${list_file}"
    echo "backup archive is not readable as tar.gz: ${archive}" >&2
    return 1
  fi

  if grep -Eq '(^/|(^|/)\.\.(/|$))' "${list_file}"; then
    rm -f "${list_file}"
    echo "backup archive contains unsafe absolute or parent-relative paths" >&2
    return 1
  fi

  failed=0
  require_entry() {
    pattern="$1"
    label="$2"
    if grep -Eq "${pattern}" "${list_file}"; then
      echo "PASS ${label}"
    else
      echo "FAIL ${label}"
      failed=1
    fi
  }

  echo "backup: ${archive}"
  echo
  if grep -qx 'obos-backup-manifest.txt' "${list_file}"; then
    echo "manifest:"
    tar -xOzf "${archive}" obos-backup-manifest.txt | sed 's/^/  /'
  else
    echo "manifest: missing"
    failed=1
  fi
  echo

  require_entry '^obos-backup-manifest\.txt$' 'backup manifest present'
  require_entry '^appliance-id$' 'appliance identifier present'
  require_entry '(^|/)openbridgeserver\.env$' 'app environment present'
  require_entry '^data(/|$)' 'open bridge server data present'
  require_entry '^mqtt(/|$)' 'Mosquitto data present'
  require_entry '^compose\.yaml$' 'Compose file present'
  require_entry '^mosquitto\.conf$' 'Mosquitto config present'

  if grep -Eq '^tls/obos-local-ca\.key$|^tls/obos\.local\.key$' "${list_file}"; then
    echo "PASS TLS private key material present"
  else
    echo "WARN TLS private key material not present"
  fi

  rm -f "${list_file}"
  if [ "${failed}" -eq 0 ]; then
    echo "restore inspect: PASS"
  else
    echo "restore inspect: FAIL"
  fi
  return "${failed}"
}

restore_plan() {
  archive="${1:-}"
  [ -n "${archive}" ] || {
    echo "usage: obosctl restore-plan <backup.tar.gz>" >&2
    return 2
  }

  if ! restore_inspect "${archive}" >/dev/null; then
    echo "restore plan: blocked; backup inspection failed" >&2
    return 1
  fi

  echo "restore plan: ${archive}"
  echo
  echo "mode=non-destructive"
  echo "format=obos-restore-plan-v1"
  echo "app=${APP_NAME}"
  echo "service=${SERVICE_NAME}"
  echo "app_dir=${APP_DIR}"
  echo "env_file=${ENV_FILE}"
  echo "appliance_id_file=${APPLIANCE_ID_FILE}"
  echo "tls_dir=${TLS_DIR}"
  echo
  echo "steps:"
  echo "  1. create a fresh pre-restore backup with: sudo obosctl backup"
  echo "  2. stop ${SERVICE_NAME}"
  echo "  3. restore app environment to ${ENV_FILE}"
  echo "  4. restore appliance identifier to ${APPLIANCE_ID_FILE}"
  echo "  5. restore open bridge server data below ${APP_DIR}/data"
  echo "  6. restore Mosquitto data below ${APP_DIR}/mqtt"
  echo "  7. restore Compose metadata below ${APP_DIR}"
  echo "  8. restore TLS identity material to ${TLS_DIR} when present"
  echo "  9. normalize permissions for restored paths"
  echo "  10. start ${SERVICE_NAME}"
  echo "  11. verify localhost and HTTPS proxy health"
  echo "  12. run the security baseline audit"
  echo
  echo "identity:"
  if tar -tzf "${archive}" | grep -Eq '^tls/obos-local-ca\.key$|^tls/obos\.local\.key$'; then
    echo "  tls_private_keys=present"
    echo "  effect=restore preserves appliance TLS identity"
  else
    echo "  tls_private_keys=missing"
    echo "  effect=restore will require new TLS trust onboarding"
  fi
  echo
  echo "restore plan: PASS"
}

restore_stage() {
  archive="${1:-}"
  [ -n "${archive}" ] || {
    echo "usage: obosctl restore-stage <backup.tar.gz>" >&2
    return 2
  }

  if ! restore_inspect "${archive}" >/dev/null; then
    echo "restore stage: blocked; backup inspection failed" >&2
    return 1
  fi

  install -d -m 0700 "${RESTORE_STAGE_DIR}"
  stage_dir="$(mktemp -d "${RESTORE_STAGE_DIR}/restore.XXXXXXXX")"
  chmod 0700 "${stage_dir}"
  tar -xzf "${archive}" -C "${stage_dir}"
  stage_manifest="${stage_dir}/obos-restore-stage.txt"
  staged_at="$(date -u +%Y%m%dT%H%M%SZ)"
  tls_private_keys="missing"
  if tar -tzf "${archive}" | grep -Eq '^tls/obos-local-ca\.key$|^tls/obos\.local\.key$'; then
    tls_private_keys="present"
  fi
  cat > "${stage_manifest}" <<EOF
format=obos-restore-stage-v1
staged_at=${staged_at}
source_backup=${archive}
app=${APP_NAME}
service=${SERVICE_NAME}
stage_dir=${stage_dir}
mode=staged-only
tls_private_keys=${tls_private_keys}
EOF
  chmod 0600 "${stage_manifest}"

  echo "restore stage: PASS"
  echo "stage_dir=${stage_dir}"
  echo "stage_manifest=${stage_manifest}"
  echo "mode=staged-only"
  echo "next=review staged files, then run: sudo obosctl restore-apply-plan ${stage_dir}"
}

restore_stage_inspect() {
  stage_dir="${1:-}"
  [ -n "${stage_dir}" ] || {
    echo "usage: obosctl restore-stage-inspect <stage-dir>" >&2
    return 2
  }
  [ -d "${stage_dir}" ] || {
    echo "restore stage not found: ${stage_dir}" >&2
    return 1
  }

  stage_manifest="${stage_dir}/obos-restore-stage.txt"
  env_name="$(basename -- "${ENV_FILE}")"
  failed=0

  require_stage_entry() {
    rel_path="$1"
    label="$2"
    if [ -e "${stage_dir}/${rel_path}" ]; then
      echo "PASS ${label}"
    else
      echo "FAIL ${label}"
      failed=1
    fi
  }

  require_stage_manifest_value() {
    pattern="$1"
    label="$2"
    if grep -q "${pattern}" "${stage_manifest}" 2>/dev/null; then
      echo "PASS ${label}"
    else
      echo "FAIL ${label}"
      failed=1
    fi
  }

  echo "restore stage: ${stage_dir}"
  echo
  if [ -f "${stage_manifest}" ]; then
    echo "stage manifest:"
    sed 's/^/  /' "${stage_manifest}"
  else
    echo "stage manifest: missing"
    failed=1
  fi
  echo

  require_stage_manifest_value '^format=obos-restore-stage-v1$' 'stage manifest format'
  require_stage_manifest_value '^mode=staged-only$' 'stage-only mode'
  require_stage_manifest_value "^app=${APP_NAME}$" 'stage manifest app'
  require_stage_entry obos-backup-manifest.txt 'backup manifest staged'
  require_stage_entry appliance-id 'appliance identifier staged'
  require_stage_entry "${env_name}" 'app environment staged'
  require_stage_entry data 'open bridge server data staged'
  require_stage_entry mqtt 'Mosquitto data staged'
  require_stage_entry compose.yaml 'Compose file staged'
  require_stage_entry mosquitto.conf 'Mosquitto config staged'

  if [ -e "${stage_dir}/mqtt/log" ]; then
    echo "FAIL Mosquitto logs absent"
    failed=1
  else
    echo "PASS Mosquitto logs absent"
  fi

  if [ "${failed}" -eq 0 ]; then
    echo "restore stage inspect: PASS"
  else
    echo "restore stage inspect: FAIL"
  fi
  return "${failed}"
}

restore_stage_summary() {
  echo "format=obos-restore-stage-summary-v1"
  echo "restore_stage_dir=${RESTORE_STAGE_DIR}"

  if [ ! -d "${RESTORE_STAGE_DIR}" ]; then
    echo "stage_dir_present=false"
    echo "stage_count=0"
    return 0
  fi

  echo "stage_dir_present=true"
  stage_count=0
  for stage_dir in "${RESTORE_STAGE_DIR}"/restore.*; do
    [ -d "${stage_dir}" ] || continue
    stage_count=$((stage_count + 1))
    stage_manifest="${stage_dir}/obos-restore-stage.txt"
    if [ -f "${stage_manifest}" ]; then
      manifest_present=true
      source_backup="$(sed -n 's/^source_backup=//p' "${stage_manifest}" | head -n 1)"
      staged_at="$(sed -n 's/^staged_at=//p' "${stage_manifest}" | head -n 1)"
      tls_private_keys="$(sed -n 's/^tls_private_keys=//p' "${stage_manifest}" | head -n 1)"
    else
      manifest_present=false
      source_backup=unknown
      staged_at=unknown
      tls_private_keys=unknown
    fi
    if restore_stage_inspect "${stage_dir}" >/dev/null 2>&1; then
      inspection=pass
    else
      inspection=fail
    fi
    echo "stage=${stage_dir}|manifest_present=${manifest_present}|inspection=${inspection}|staged_at=${staged_at:-unknown}|source_backup=${source_backup:-unknown}|tls_private_keys=${tls_private_keys:-unknown}"
  done
  echo "stage_count=${stage_count}"
}

restore_apply_plan() {
  stage_dir="${1:-}"
  [ -n "${stage_dir}" ] || {
    echo "usage: obosctl restore-apply-plan <stage-dir>" >&2
    return 2
  }

  if ! restore_stage_inspect "${stage_dir}" >/dev/null; then
    echo "restore apply plan: blocked; restore stage inspection failed" >&2
    return 1
  fi

  echo "restore apply plan: ${stage_dir}"
  echo
  echo "mode=non-destructive"
  echo "format=obos-restore-apply-plan-v1"
  echo "app=${APP_NAME}"
  echo "service=${SERVICE_NAME}"
  echo "stage_dir=${stage_dir}"
  echo "app_dir=${APP_DIR}"
  echo "env_file=${ENV_FILE}"
  echo "appliance_id_file=${APPLIANCE_ID_FILE}"
  echo "tls_dir=${TLS_DIR}"
  echo
  echo "required_gates:"
  echo "  - restore-stage-inspect must pass for ${stage_dir}"
  echo "  - create a fresh pre-restore backup with: sudo obosctl backup"
  echo "  - require: sudo obosctl restore-apply ${stage_dir} --confirm restore-apply"
  echo "  - stop ${SERVICE_NAME} before replacing live files"
  echo "  - normalize restored file permissions before restart"
  echo "  - verify localhost and HTTPS proxy health after restart"
  echo "  - run the security baseline audit after restart"
  echo
  echo "apply_steps:"
  echo "  1. copy staged app environment to ${ENV_FILE}"
  echo "  2. copy staged appliance identifier to ${APPLIANCE_ID_FILE}"
  echo "  3. replace ${APP_DIR}/data with staged open bridge server data"
  echo "  4. replace ${APP_DIR}/mqtt with staged Mosquitto data"
  echo "  5. copy staged Compose metadata into ${APP_DIR}"
  echo "  6. restore staged TLS identity material to ${TLS_DIR} when present"
  echo "  7. start ${SERVICE_NAME}"
  echo
  echo "restore apply plan: PASS"
}

require_restore_apply_targets_safe() {
  case "${APP_DIR}" in
    /srv/obos/apps/*) ;;
    *) echo "restore apply: unsafe app directory: ${APP_DIR}" >&2; return 2 ;;
  esac
  case "${ENV_FILE}" in
    /etc/obos/apps/*.env) ;;
    *) echo "restore apply: unsafe environment file: ${ENV_FILE}" >&2; return 2 ;;
  esac
  case "${APPLIANCE_ID_FILE}" in
    /etc/obos/appliance-id) ;;
    *) echo "restore apply: unsafe appliance id file: ${APPLIANCE_ID_FILE}" >&2; return 2 ;;
  esac
  case "${TLS_DIR}" in
    /etc/obos/tls) ;;
    *) echo "restore apply: unsafe TLS directory: ${TLS_DIR}" >&2; return 2 ;;
  esac
}

restore_apply() {
  require_root restore-apply
  stage_dir="${1:-}"
  confirm_flag="${2:-}"
  confirm_value="${3:-}"
  [ -n "${stage_dir}" ] || {
    echo "usage: obosctl restore-apply <stage-dir> --confirm restore-apply" >&2
    return 2
  }
  if [ "${confirm_flag}" != "--confirm" ] || [ "${confirm_value}" != "restore-apply" ]; then
    echo "restore apply: explicit confirmation required: --confirm restore-apply" >&2
    return 2
  fi
  case "${stage_dir}" in
    "${RESTORE_STAGE_DIR}"/restore.*) ;;
    *) echo "restore apply: stage directory must be below ${RESTORE_STAGE_DIR}" >&2; return 2 ;;
  esac
  case "${stage_dir}" in
    *'/../'*|*'/..'|'../'*|..)
      echo "restore apply: stage directory must not contain parent traversal" >&2
      return 2
      ;;
  esac
  require_restore_apply_targets_safe
  if ! restore_stage_inspect "${stage_dir}" >/dev/null; then
    echo "restore apply: blocked; restore stage inspection failed" >&2
    return 1
  fi

  env_name="$(basename -- "${ENV_FILE}")"
  pre_restore_backup_output="$(backup)"
  pre_restore_backup="$(printf '%s\n' "${pre_restore_backup_output}" | sed -n 's/^backup: //p')"
  if [ -z "${pre_restore_backup}" ] || [ ! -f "${pre_restore_backup}" ]; then
    echo "restore apply: blocked; pre-restore backup was not created" >&2
    return 1
  fi

  restore_state_dir="${STATE_DIR}/restore-apply"
  install -d -m 0750 "${restore_state_dir}"
  applied_at="$(date -u +%Y%m%dT%H%M%SZ)"
  state_file="${restore_state_dir}/last-restore-apply"
  tmp_state="${state_file}.$$"

  systemctl stop "${SERVICE_NAME}"

  install -d -m 0750 "$(dirname -- "${ENV_FILE}")" "${APP_DIR}" "$(dirname -- "${APPLIANCE_ID_FILE}")"
  install -m 0600 "${stage_dir}/${env_name}" "${ENV_FILE}"
  install -m 0600 "${stage_dir}/appliance-id" "${APPLIANCE_ID_FILE}"

  rm -rf -- "${APP_DIR}/data" "${APP_DIR}/mqtt"
  cp -a "${stage_dir}/data" "${APP_DIR}/data"
  cp -a "${stage_dir}/mqtt" "${APP_DIR}/mqtt"
  install -m 0644 "${stage_dir}/compose.yaml" "${APP_DIR}/compose.yaml"
  install -m 0644 "${stage_dir}/mosquitto.conf" "${APP_DIR}/mosquitto.conf"
  if [ -f "${stage_dir}/obos-app.yaml" ]; then
    install -m 0644 "${stage_dir}/obos-app.yaml" "${APP_DIR}/obos-app.yaml"
  fi

  tls_restore=skipped
  if [ -d "${stage_dir}/tls" ]; then
    rm -rf -- "${TLS_DIR}"
    install -d -m 0700 "$(dirname -- "${TLS_DIR}")"
    cp -a "${stage_dir}/tls" "${TLS_DIR}"
    tls_restore=restored
  fi

  chmod 0750 "${APP_DIR}" "${APP_DIR}/data" "${APP_DIR}/mqtt" 2>/dev/null || true
  chmod 0600 "${ENV_FILE}" "${APPLIANCE_ID_FILE}"
  if [ -d "${TLS_DIR}" ]; then
    chmod 0700 "${TLS_DIR}"
    find "${TLS_DIR}" -type f -name '*.key' -exec chmod 0600 {} \;
    find "${TLS_DIR}" -type f ! -name '*.key' -exec chmod 0644 {} \;
  fi

  systemctl start "${SERVICE_NAME}"

  health_local=failed
  if health; then
    health_local=ok
  fi
  health_https_proxy=failed
  if proxy_health; then
    health_https_proxy=ok
  fi
  security_baseline=not-run
  if [ -x "${SECURITY_BASELINE_SCRIPT}" ]; then
    if "${SECURITY_BASELINE_SCRIPT}" summary >/dev/null; then
      security_baseline=pass
    else
      security_baseline=fail
    fi
  fi

  cat > "${tmp_state}" <<EOF
format=obos-restore-apply-v1
applied_at=${applied_at}
stage_dir=${stage_dir}
pre_restore_backup=${pre_restore_backup}
app=${APP_NAME}
service=${SERVICE_NAME}
app_dir=${APP_DIR}
env_file=${ENV_FILE}
appliance_id_file=${APPLIANCE_ID_FILE}
tls_restore=${tls_restore}
health_local=${health_local}
health_https_proxy=${health_https_proxy}
security_baseline=${security_baseline}
EOF
  chmod 0640 "${tmp_state}"
  mv -f "${tmp_state}" "${state_file}"

  echo "format=obos-restore-apply-v1"
  echo "stage_dir=${stage_dir}"
  echo "pre_restore_backup=${pre_restore_backup}"
  echo "tls_restore=${tls_restore}"
  echo "health_local=${health_local}"
  echo "health_https_proxy=${health_https_proxy}"
  echo "security_baseline=${security_baseline}"
  echo "state_file=${state_file}"

  if [ "${health_local}" != ok ] || [ "${health_https_proxy}" != ok ] || [ "${security_baseline}" != pass ]; then
    echo "restore apply: completed with failed post-restore checks" >&2
    return 1
  fi
  echo "restore apply: PASS"
}

write_update_state() {
  backup_path="$1"
  state_dir="$(dirname -- "${LAST_UPDATE_FILE}")"
  completed_at="$(date -u +%Y%m%dT%H%M%SZ)"
  tmp_file="${LAST_UPDATE_FILE}.$$"

  install -d -m 0750 "${state_dir}"
  cat > "${tmp_file}" <<EOF
format=obos-update-v1
completed_at=${completed_at}
app=${APP_NAME}
service=${SERVICE_NAME}
pre_update_backup_required=true
pre_update_backup_created=true
backup=${backup_path}
health_local=ok
health_https_proxy=ok
EOF
  chmod 0640 "${tmp_file}"
  mv -f "${tmp_file}" "${LAST_UPDATE_FILE}"
}

update_app() {
  require_root update
  require_files
  backup_output="$(backup)"
  printf '%s\n' "${backup_output}"
  backup_path="$(printf '%s\n' "${backup_output}" | sed -n 's/^backup: //p')"
  if [ -z "${backup_path}" ] || [ ! -f "${backup_path}" ]; then
    echo "update: blocked; pre-update backup was not created" >&2
    return 1
  fi
  compose pull
  systemctl restart "${SERVICE_NAME}"

  tries=30
  while [ "${tries}" -gt 0 ]; do
    if health && proxy_health; then
      write_update_state "${backup_path}"
      echo "update: health checks passed"
      echo "update-state: ${LAST_UPDATE_FILE}"
      return 0
    fi
    tries=$((tries - 1))
    sleep 2
  done

  echo "update: health checks failed after restart" >&2
  return 1
}

update_summary() {
  echo "format=obos-update-summary-v1"
  echo "state_file=${LAST_UPDATE_FILE}"

  if [ ! -f "${LAST_UPDATE_FILE}" ]; then
    echo "last_update_present=false"
    return 0
  fi

  echo "last_update_present=true"
  sed 's/^/last_update_/' "${LAST_UPDATE_FILE}"
}

update_rollback_plan() {
  require_root update-rollback-plan
  if [ ! -f "${LAST_UPDATE_FILE}" ]; then
    echo "update rollback plan: blocked; last update state missing" >&2
    return 1
  fi

  backup_path="$(key_value backup "${LAST_UPDATE_FILE}")"
  completed_at="$(key_value completed_at "${LAST_UPDATE_FILE}")"
  [ -n "${backup_path}" ] || {
    echo "update rollback plan: blocked; backup path missing from last update state" >&2
    return 1
  }
  [ -f "${backup_path}" ] || {
    echo "update rollback plan: blocked; backup missing: ${backup_path}" >&2
    return 1
  }
  if ! restore_inspect "${backup_path}" >/dev/null; then
    echo "update rollback plan: blocked; backup inspection failed" >&2
    return 1
  fi

  echo "update rollback plan: ${backup_path}"
  echo
  echo "mode=non-destructive"
  echo "format=obos-update-rollback-plan-v1"
  echo "state_file=${LAST_UPDATE_FILE}"
  echo "last_update_completed_at=${completed_at}"
  echo "backup=${backup_path}"
  echo "backup_present=true"
  echo
  echo "next_steps:"
  echo "  1. run: sudo obosctl restore-plan ${backup_path}"
  echo "  2. run: sudo obosctl restore-stage ${backup_path}"
  echo "  3. inspect the staged restore before confirmed CLI apply"
  echo "  4. run: sudo obosctl restore-apply-plan <stage-dir>"
  echo
  echo "update rollback plan: PASS"
}

update_rollback_stage() {
  require_root update-rollback-stage
  if [ ! -f "${LAST_UPDATE_FILE}" ]; then
    echo "update rollback stage: blocked; last update state missing" >&2
    return 1
  fi

  backup_path="$(key_value backup "${LAST_UPDATE_FILE}")"
  completed_at="$(key_value completed_at "${LAST_UPDATE_FILE}")"
  [ -n "${backup_path}" ] || {
    echo "update rollback stage: blocked; backup path missing from last update state" >&2
    return 1
  }
  [ -f "${backup_path}" ] || {
    echo "update rollback stage: blocked; backup missing: ${backup_path}" >&2
    return 1
  }
  if ! restore_inspect "${backup_path}" >/dev/null; then
    echo "update rollback stage: blocked; backup inspection failed" >&2
    return 1
  fi

  stage_output="$(restore_stage "${backup_path}")"
  stage_dir="$(printf '%s\n' "${stage_output}" | sed -n 's/^stage_dir=//p' | head -n 1)"
  [ -n "${stage_dir}" ] || {
    echo "update rollback stage: blocked; restore staging failed" >&2
    return 1
  }

  echo "format=obos-update-rollback-stage-v1"
  echo "state_file=${LAST_UPDATE_FILE}"
  echo "last_update_completed_at=${completed_at}"
  echo "backup=${backup_path}"
  echo "stage_dir=${stage_dir}"
  echo "mode=staged-only"
  echo "live_apply_allowed=false"
  echo "next=review staged files, then run: sudo obosctl restore-apply-plan ${stage_dir}"
  echo "update rollback stage: PASS"
}

case "${1:-}" in
  status)
    status
    ;;
  status-summary)
    status_summary
    ;;
  system-summary)
    system_summary
    ;;
  set-hostname)
    shift
    set_hostname "${1:-}"
    ;;
  set-timezone)
    shift
    set_timezone "${1:-}"
    ;;
  security-summary)
    require_root security-summary
    run_helper "${SECURITY_BASELINE_SCRIPT}" summary
    ;;
  mvp-readiness-summary)
    require_root mvp-readiness-summary
    run_helper "${MVP_READINESS_SCRIPT}" summary
    ;;
  web-auth-rotate)
    require_root web-auth-rotate
    run_helper "${WEB_AUTH_SCRIPT}" rotate
    ;;
  web-auth-set)
    require_root web-auth-set
    shift
    password_file="${1:-}"
    [ "${2:-}" = "--confirm" ] && [ "${3:-}" = "web-auth-set" ] || {
      echo "usage: obosctl web-auth-set <password-file> --confirm web-auth-set" >&2
      exit 2
    }
    validate_onboarding_password_file "${password_file}"
    run_helper "${WEB_AUTH_SCRIPT}" set "${password_file}"
    rm -f "${password_file}"
    ;;
  agent-audit-summary)
    shift
    agent_audit_summary "${1:-}"
    ;;
  start)
    require_root start
    systemctl start "${SERVICE_NAME}"
    ;;
  stop)
    require_root stop
    systemctl stop "${SERVICE_NAME}"
    ;;
  restart)
    require_root restart
    systemctl restart "${SERVICE_NAME}"
    ;;
  update)
    update_app
    ;;
  update-summary)
    update_summary
    ;;
  update-rollback-plan)
    update_rollback_plan
    ;;
  update-rollback-stage)
    update_rollback_stage
    ;;
  logs)
    compose logs -f --tail=200
    ;;
  logs-summary)
    logs_summary
    ;;
  logs-tail)
    logs_tail
    ;;
  backup)
    backup
    ;;
  backup-summary)
    backup_summary
    ;;
  backup-list)
    backup_list
    ;;
  backup-prune-plan)
    shift
    backup_prune_plan "${1:-}"
    ;;
  backup-prune)
    shift
    backup_prune "$@"
    ;;
  portable-export-plan)
    shift
    portable_export_plan "${1:-}"
    ;;
  portable-export)
    shift
    portable_export "${1:-}" "${2:-}"
    ;;
  portable-import-plan)
    shift
    portable_import_plan "${1:-}"
    ;;
  portable-import-stage)
    shift
    portable_import_stage "${1:-}" "${2:-}"
    ;;
  restore-inspect)
    shift
    restore_inspect "${1:-}"
    ;;
  restore-plan)
    shift
    restore_plan "${1:-}"
    ;;
  restore-stage)
    require_root restore-stage
    shift
    restore_stage "${1:-}"
    ;;
  restore-stage-inspect)
    require_root restore-stage-inspect
    shift
    restore_stage_inspect "${1:-}"
    ;;
  restore-stage-summary)
    require_root restore-stage-summary
    restore_stage_summary
    ;;
  restore-apply-plan)
    require_root restore-apply-plan
    shift
    restore_apply_plan "${1:-}"
    ;;
  restore-apply)
    shift
    restore_apply "${1:-}" "${2:-}" "${3:-}"
    ;;
  health)
    health
    ;;
  proxy-health)
    proxy_health
    ;;
  tls-generate)
    require_root tls-generate
    run_helper "${TLS_GENERATE_SCRIPT}"
    ;;
  tls-renew-leaf-plan)
    run_helper "${TLS_LEAF_RENEWAL_PLAN_SCRIPT}"
    ;;
  tls-renew-leaf)
    require_root tls-renew-leaf
    shift
    run_helper "${TLS_LEAF_RENEWAL_SCRIPT}" "${1:-}" "${2:-}"
    ;;
  tls-status)
    run_helper "${TLS_STATUS_SCRIPT}"
    ;;
  tls-summary)
    run_helper "${TLS_STATUS_SCRIPT}" summary
    ;;
  tls-info)
    require_root tls-info
    run_helper "${TLS_INFO_SCRIPT}"
    ;;
  tls-export)
    require_root tls-export
    run_helper "${TLS_EXPORT_SCRIPT}"
    ;;
  tls-export-boot)
    require_root tls-export-boot
    run_helper "${BOOT_TRUST_SCRIPT}"
    ;;
  mqtt-status)
    require_root mqtt-status
    run_helper "${MQTT_LAN_SCRIPT}" status
    ;;
  mqtt-summary)
    require_root mqtt-summary
    run_helper "${MQTT_LAN_SCRIPT}" summary
    ;;
  mqtt-enable-lan)
    require_root mqtt-enable-lan
    shift
    run_helper "${MQTT_LAN_SCRIPT}" enable "${1:-}"
    ;;
  mqtt-disable-lan)
    require_root mqtt-disable-lan
    run_helper "${MQTT_LAN_SCRIPT}" disable
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
